APP_NAME=Expense Tracker API
# PostgreSQL database. Leave unset to use a built-in SQLite database (starts empty, stored in /app/data)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Long random secret for signing login tokens (if unset, one is generated and saved in /app/data). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me

# Optional
# How long a login lasts (default 1440 = 1 day)
# JWT_EXPIRE_MINUTES=1440
# The login token is sent in an HttpOnly session cookie. Keep COOKIE_SECURE=true behind HTTPS;
# false only for plain-http setups that aren't localhost.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=strict
# CORS_ORIGINS=["https://expense-tracker-react-project-gilt.vercel.app"]

# ---------- Security ----------
# Interactive API docs at /docs (off by default; turn on for local development only)
# ENABLE_API_DOCS=true
# Limits on login / signup / password-reset attempts
# RATE_LIMIT_ENABLED=true
# Behind a reverse proxy, the proxy addresses whose X-Forwarded-For header is trusted for the client IP
# (read by uvicorn; the default 127.0.0.1 means a remote proxy's IP is used for everyone)
# FORWARDED_ALLOW_IPS=*

# ---------- Forgot password ----------
# URL of the React app; reset links in emails point here
FRONTEND_URL=http://localhost:5173
# PASSWORD_RESET_EXPIRE_MINUTES=30

# SMTP for sending reset emails. Leave SMTP_HOST empty to print the reset link in the server log instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, an App Password as SMTP_PASSWORD
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Expense Tracker <no-reply@example.com>
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
